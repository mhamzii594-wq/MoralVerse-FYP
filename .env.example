# MoralVerse.AI Environment Variables Example
# Copy this file to .env and fill in your API keys.

# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here

# LLM Providers (gemini, openai, groq)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key
OPENAI_API_KEY=your-openai-key
GROQ_API_KEY=your-groq-key

# Image Providers (gemini, stability, openai)
IMAGE_PROVIDER=gemini
STABILITY_API_KEY=your-stability-key

# TTS Providers (gemini, openai, elevenlabs, coqui)
TTS_PROVIDER=gemini
ELEVENLABS_API_KEY=your-elevenlabs-key

# Video Rendering (optional)
FORCE_CPU=false
SUBTITLE_FONT=Arial-Bold

# Security & Optimization
USE_STUB_MODE=false
DAILY_STORY_LIMIT=3
